# Run outputs
result/*

# Python bytecode caches (anywhere in the repo)
__pycache__/
*.py[cod]
*$py.class

# IDE
.idea/

# Local profiling / experiment scripts (not part of the core package)
scripts/

# Cython extension: track sources only, not build artifacts
search/cython_heuristics/**
!search/cython_heuristics/heuristics.pyx
!search/cython_heuristics/setup.py
